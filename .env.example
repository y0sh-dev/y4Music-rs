# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# SQLite database file. sqlx will create it on first run if it doesn't exist.
DATABASE_URL=sqlite://data/y1music.db

# Optional: set to a guild (server) ID to instantly sync slash commands to a
# single test server instead of waiting up to an hour for a global sync.
TEST_GUILD_ID=
